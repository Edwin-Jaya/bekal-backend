# ============================================================
# BEKAL BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi .env dan sesuaikan nilainya
# ============================================================

# ─── Database ────────────────────────────────────────────────
DB_URL=jdbc:sqlserver://sqlserver:1433;databaseName=bekal;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=YourStrongDatabasePassword!

# ─── Redis ───────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT Security ───────────────────────────────────────────
# Rahasia tanda tangan JWT (minimal 256-bit base64/hex)
JWT_SECRET=your-secure-jwt-secret-key-at-least-256-bits-long
JWT_TTL_MINUTES=180m

# ─── Mail Server ─────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password

# ─── JPA / Hibernate ─────────────────────────────────────────
JPA_DDL_AUTO=none
JPA_SHOW_SQL=false

# ─── File Uploads ────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB

# ─── Logging ─────────────────────────────────────────────────
CACHE_LOG_LEVEL=WARN
SQL_LOG_LEVEL=WARN
